# Required bridge and ngrok configuration
BRIDGE_PORT=5631
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# F1 TV authentication
# Use "automatic" on PC/Docker with Playwright, or "manual" on Termux/Android.
F1TV_AUTH_MODE=automatic
F1TV_EMAIL=
F1TV_PASSWORD=
# Optional fallback/manual token. In manual mode, set it through Swagger instead.
F1TVSUBSCRIPTION_TOKEN=

# Credentials for outgoing requests to the F1 Telemetry API (optional).
# They are not required to access local bridge endpoints.
F1T_API_URL=https://api.f1telemetry.com
# Closed session recordings upload automatically when API credentials are configured.
# Set to false to keep recordings local only.
F1T_RECORDINGS_AUTO_UPLOAD=true
# Configure both credentials for automatic login, or leave both empty and set
# the token manually through POST /api/config/telemetry-token.
F1T_API_EMAIL=
F1T_API_PASSWORD=
F1T_API_TOKEN=

# Optional settings
# Recordings default to ./recordings; set an absolute path to store them elsewhere.
# F1_RECORDINGS_DIR=./recordings
# NGROK_BIN_PATH=ngrok
# F1TV_SHOW_BROWSER=false
# F1TV_PLAYWRIGHT_EXECUTABLE_PATH=

# Token status and last-update fields are managed by the bridge.
